#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Eiginleikurin \"%1$s\" á blokktagginum %2$s verður sleptur, tí blokkin ikki hevur lýst nakran teig við hesum samleika. Lýs teigin, ella skriva hann sum ein data-, aria- ella html-eiginleika, so hann verður settur á rótelementið."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Hesin goymslulykilin er ikki lýstur av blokkinum ella útbyggingum hansara."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Hesin yvirskipaði lykilin er ikki ein eginleiki hjá blokkinum, so hann verður ikki tikin við."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Hesin lykilin verður bara lisin inni í blockstudio-objektinum, sum manglar."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Hesin virðið er ikki millum møguleikarnar hjá teiginum."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Hesin virðisskapur er ikki stuðlaður fyri teigin."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Hesin endurtakari hevur færri raðir enn minstamarkið."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Hesin endurtakari hevur fleiri raðir enn hámarkið."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Hesin goymslulykilin hevur mótstríðandi teigalýsingar."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Virðið í innara teiginum setur hetta virðið úr gildi."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Bindingar í útbyggingum lesa hetta virðið bert frá blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Virði í Blockstudio-teigum skulu goymast í einum objekti."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio fyrireikar blokkskyndiminnið. Royn aftur um eina løtu."

#: includes/classes/canvas.php
msgid "Canvas is disabled."
msgstr "Canvas er óvirkjað."

