#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "L’attribut « %1$s » de la balise de bloc %2$s est ignoré, car le bloc ne déclare aucun champ avec cet identifiant. Déclarez le champ ou écrivez l’attribut sous la forme data-, aria- ou html- pour l’ajouter à l’élément racine."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Cette clé de stockage n’est déclarée ni par le bloc ni par ses extensions."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Cette clé de premier niveau n’est pas un attribut du bloc; elle est donc ignorée."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Cette clé est lue uniquement dans l’objet blockstudio, qui est manquant."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Cette valeur ne fait pas partie des options du champ."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Cette valeur a une forme non prise en charge pour le champ."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Ce répéteur contient moins de rangées que le minimum autorisé."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Ce répéteur contient plus de rangées que le maximum autorisé."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Cette clé de stockage est associée à des définitions de champ incompatibles."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "La valeur du champ imbriqué remplace cette valeur de premier niveau."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Les liaisons d’extension lisent cette valeur uniquement à partir de blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Les valeurs des champs Blockstudio doivent être stockées dans un objet."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio prépare son cache de blocs. Veuillez réessayer sous peu."

#: includes/classes/canvas.php
msgid "Canvas is disabled."
msgstr "Le canevas est désactivé."

