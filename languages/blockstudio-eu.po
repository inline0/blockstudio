#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "%2$s blokearen etiketako \"%1$s\" atributua baztertu egin da, blokeak ez baitu ID hori duen eremurik deklaratzen. Deklaratu eremua, edo idatzi data-, aria- edo html- atributu gisa erro-elementuan gehitzeko."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Biltegiratze-gako hau ez dute blokeak edo haren hedapenek deklaratu."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Goiko mailako gako hau ez da blokearen atributua, eta ez da kontuan hartzen."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Gako hau blockstudio objektuaren barruan soilik irakurtzen da, baina objektu hori falta da."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Balio hau ez dago eremuaren aukeren artean."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Balio honen egitura ez da bateragarria eremuarekin."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Errepikagailu honek gutxienekoa baino errenkada gutxiago ditu."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Errepikagailu honek gehienekoa baino errenkada gehiago ditu."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Biltegiratze-gako honek eremu-definizio gatazkatsuak ditu."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Habiaratutako eremuaren balioak goi-mailako balio hau gainidazten du."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Hedapenen loturek blockstudio.attributes-etik soilik irakurtzen dute balio hau."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Blockstudio eremuen balioak objektu batean gorde behar dira."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio blokeen cachea prestatzen ari da. Saiatu berriro laster."

#: includes/classes/canvas.php
msgid "Canvas is disabled."
msgstr "Canvas desgaituta dago."

