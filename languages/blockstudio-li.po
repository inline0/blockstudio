msgstr "Deze repeater heeft meer rijen dan het maximum."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Deze opslagkey heeft conflicterende velddefinities."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "De waarde van het geneste veld overschrijft deze top-level waarde."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Extensiebindingen lezen deze waarde alleen uit blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Blockstudio-veldwaarden moeten in een object worden opgeslagen."

