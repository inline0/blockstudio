msgid "This repeater has more rows than its maximum."
msgstr "Bul qaytalawshıda eń kóp mánisinen kóp qatar bar."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Bul saqlaw giltı ushın maydan anıqlamaları bir-birine sáykes kelmeydi."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Ishki maydan mánisi joqarı dárejedegi bul mánisti basıp ketedi."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Keńeytpe baylanıslıqları bul mánisti tek blockstudio.attributes ishinen oqıydı."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Blockstudio maydan mánisleri obyekt túrinde saqlanıwı kerek."

