#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Den Attribut „%1$s“ um Block-Tag %2$s gëtt verworf, well de Block kee Feld mat där ID deklaréiert. Deklaréier d'Feld oder schreiw et als data-, aria- oder html-Attribut, fir et um Root-Element ofzeleeën."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Dëse Späicherschlëssel ass weder vum Block nach vu sengen Erweiderunge deklaréiert."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Dëse Schlëssel op der ieweschter Niveau ass keen Attribut vum Block a gëtt dofir ignoréiert."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Dëse Schlëssel gëtt nëmmen am blockstudio-Objet gelies, dat feelt."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Dëse Wäert ass keng vun den Optioune vum Feld."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Dëse Wäert huet eng net ënnerstëtzt Struktur fir dëst Feld."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Dëse Repeater huet manner Zeile wéi de Minimum."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Dëse Repeater huet méi Zeile wéi de Maximum."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Fir dëse Späicherschlëssel gi widderspréchlech Felddefinitioune benotzt."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "De Wäert am verschachtelte Feld iwwerschreift dësen Top-Level-Wäert."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Bindunge vun Erweiderunge liesen dëse Wäert nëmmen aus blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Blockstudio-Feldwäerter mussen an engem Objet gespäichert ginn."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio bereet de Block-Cache vir. Probéier et kuerz drop nach eng Kéier."

