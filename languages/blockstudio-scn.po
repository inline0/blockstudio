#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "L'attributu \"%1$s\" supra un tag di bloccu %2$s veni scartatu picchì lu bloccu nun dichiara nisciun campu cu chistu ID. Dichiara lu campu, o scrivìlu comu attributu data-, aria- o html- pi mettìrilu supra l'elementu radici."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Sta chiavi di archiviazioni nun è dichiarata dû bloccu o di li sò estensioni."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Sta chiavi di liveddu principali nun è n'attributu dû bloccu, e veni gnurata."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Sta chiavi veni lègguta sulu dintra l'oggettu blockstudio, chi manca."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Stu valuri nun è tra l'ozzioni dû campu."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Stu valuri havi na forma nun supportata pi lu campu."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Stu repeater havi menu filari di chiddu minimu."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Stu repeater havi cchiù filari di chiddu massimu."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Sta chiavi di archiviazioni havi definizzioni di campu cuntrastanti."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Lu valuri dû campu annidatu supravanza stu valuri di liveddu supiriuri."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Li culligamenti di l'estensioni ligginu stu valuri sulu di blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Li valuri di li campi di Blockstudio s'hannu a sarvari comu oggettu."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio sta priparannu la sò cache di blocchi. Riprova tra picca."

#: includes/classes/canvas.php
msgid "Canvas is disabled."
msgstr "Lu canvas è disattivatu."

