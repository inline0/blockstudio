msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "L’atributu «%1$s» nun bloque %2$s descártase porque’l bloque nun declara nengún campu con esi identificador. Declara’l campu o escríbilu como atributu data-, aria- o html- pa incluyilu nel elementu raíz."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Esta clave d’almacenamientu nun ta declarada pol bloque nin poles sos estensiones."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Esta clave de nivel superior nun ye un atributu del bloque, polo que s'ignora."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Esta clave namái se lleye dientro del oxetu blockstudio, que falta."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Esti valor nun ta ente les opciones del campu."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Esti valor tien una estructura incompatible col campu."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Esti repetidor tien menos files que’l mínimu."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Esti repetidor tien más files que’l máximu."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Esta clave d’almacenamientu tien definiciones de campu incompatibles."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "El valor del campu anidáu prevalez sobre esti valor de nivel superior."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Les vinculaciones de les estensiones lleen esti valor namái de blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Los valores de los campos de Blockstudio tienen d’almacenase nun oxetu."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio ta preparando la caché de bloques. Vuelve intentalo dientro de poco."

#: includes/classes/canvas.php
msgid "Canvas is disabled."
msgstr "El llenzu ta desactiváu."

