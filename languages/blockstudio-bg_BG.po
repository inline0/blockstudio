#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Атрибутът „%1$s“ на етикета на блока %2$s се премахва, защото блокът не декларира поле с този идентификатор. Декларирайте полето или го запишете като атрибут data-, aria- или html-, за да го добавите към кореновия елемент."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Този ключ за съхранение не е деклариран от блока или неговите разширения."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Този ключ от най-горно ниво не е атрибут на блока и затова се игнорира."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Този ключ се чете само в обекта blockstudio, който липсва."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Тази стойност не е сред опциите на полето."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Тази стойност е с неподдържан формат за полето."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Този повтарящ се списък съдържа по-малко редове от минималния брой."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Този повтарящ се списък съдържа повече редове от максималния брой."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "За този ключ за съхранение има конфликтни дефиниции на полета."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Стойността на вложеното поле заменя тази стойност от най-горното ниво."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Свързванията на разширенията четат тази стойност само от blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Стойностите на полетата на Blockstudio трябва да се съхраняват в обект."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio подготвя кеша на блоковете си. Опитайте отново след малко."

