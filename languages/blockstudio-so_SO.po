msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Sifada \"%1$s\" ee summadda baloogga %2$s waa la tuuray sababtoo ah balooggu ma qeexin beer leh aqoonsigaas. Qeex beerta, ama u qor sifo data-, aria- ama html- ah si loogu daro curiyaha xididka."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Furahan kaydinta kuma qeexna baloogga ama kordhinadiisa."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Furahan heerka sare ahi ma aha sifo ka mid ah block-ga, sidaas darteed waa la iska indhatiraa."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Furahan waxaa la akhriyaa oo keliya gudaha shayga blockstudio, kaas oo maqan."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Qiimahani kuma jiro xulashooyinka beerta."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Qiimahani ma laha qaab ay beertu taageerto."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Ku-celiyahani wuxuu leeyahay safaf ka yar inta ugu yar."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Ku-celiyahani wuxuu leeyahay safaf ka badan inta ugu badan."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Furahan kaydinta waxa uu leeyahay qeexitaanno beereed oo is khilaafsan."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Qiimaha beerta buulka ku jirta ayaa ka sarreeya qiimahan heerka sare."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Xidhiidhada kordhintu qiimahan waxay ka akhriyaan oo keliya blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Qiimayaasha beeraha Blockstudio waa in lagu kaydiyaa shay (object)."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio waxa uu diyaarinayaa kaydka baloogyadiisa. Fadlan mar kale isku day wax yar kadib."

