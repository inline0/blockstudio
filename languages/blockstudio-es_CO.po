#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Se descarta el atributo \"%1$s\" de la etiqueta del bloque %2$s porque el bloque no declara ningún campo con ese ID. Declara el campo o escríbelo como atributo data-, aria- o html- para incluirlo en el elemento raíz."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Esta clave de almacenamiento no está declarada por el bloque ni por sus extensiones."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Esta clave de nivel superior no es un atributo del bloque, así que se ignora."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Esta clave solo se lee dentro del objeto blockstudio, que hace falta."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Este valor no está entre las opciones del campo."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Este valor tiene una estructura no compatible con el campo."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Este repetidor tiene menos filas que el mínimo permitido."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Este repetidor tiene más filas que el máximo permitido."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Esta clave de almacenamiento tiene definiciones de campo en conflicto."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "El valor del campo anidado reemplaza este valor de nivel superior."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Los enlaces de extensión leen este valor únicamente desde blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Los valores de los campos de Blockstudio deben almacenarse en un objeto."

#: includes/classes/build.php
