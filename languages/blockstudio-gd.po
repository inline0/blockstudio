#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Tha am feart “%1$s” air taga baca %2$s air a leigeil seachad oir chan eil raon leis an ID sin aig a’ bhloc. Dearbhaich an raon, no sgrìobh e mar fheart data-, aria- no html- gus a chur air an eileamaid bhunaitich."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Chan eil an iuchair-stòraidh seo dearbhte leis a’ bhloc no leis na leudachain aige."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Thèid dearmad a dhèanamh air an iuchair aig an ìre as àirde seo oir chan eil i na buadh den bhlog."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Cha tèid an iuchair seo a leughadh ach taobh a-staigh an nì blockstudio, a tha a dhìth."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Chan eil an luach seo am measg roghainnean an raoin."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Tha cruth neo-thaiceil aig an luach seo airson an raoin."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Tha nas lugha de shreathan aig an ath-aithris seo na tha aig a’ char as lugha."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Tha barrachd shreathan aig an ath-aithris seo na tha aig a’ char as motha."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Tha mìneachaidhean raoin a tha a’ dol an aghaidh a chèile aig an iuchair-stòraidh seo."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Tha luach an raoin neadaichte a’ sgrìobhadh thairis air an luach àrd-ìre seo."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Chan eil ceanglaichean leudachaidh a’ leughadh an luach seo ach à blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Feumar luachan raoin Blockstudio a stòradh ann an nì."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Tha Blockstudio ag ullachadh tasgadan nam blocaichean. Feuch ris a-rithist a dh’aithghearr."

#: includes/classes/canvas.php
msgid "Canvas is disabled."
msgstr "Tha an canabhas à comas."

