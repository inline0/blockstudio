#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Ua topa te uiga \"%1$s\" i te tapao poraka %2$s, no te mea aita e fenua i roto i te poraka i teie id. A faataa i te fenua, aore ra a papa i te reira mai te hoê huru data-, aria- aore ra html- no te tuu i nia i te tuhaa tumu."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Aita teie taviri haaputuraa i faataahia e te poraka aore ra to ’na mau faarahiraa."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "E ere teie taviri i te hoê huru no te poraka i te faito teitei roa’e, no reira e haapa’o-ore-hia."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "E tai’ohia teie taviri i roto noa i te object blockstudio, aita râ taua object ra e vai ra."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Aita teie faufaaraa i roto i te mau maitiraa o te fenua."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Eita teie huru faufaaraa e turuhia no teie fenua."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "E iti a‘e te mau reni o teie repeater i te faito iti roa."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "E rahi a‘e te mau reni o teie repeater i te faito rahi roa."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "E mau faataaraa fenua pato‘i to teie taviri haaputuraa."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "E mono te faufaaraa o te fenua i roto i teie faufaaraa i nia."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "E taio te mau taamuraa faarahiraa i teie faufaaraa na roto noa i te blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "E mea tia ia haaputu te mau faufaaraa o te mau fenua Blockstudio i roto i te hoê tao‘a."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Te faaineine nei Blockstudio i te haaputuraa o te mau poraka. A tamata faahou rii a‘e."

