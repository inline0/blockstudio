#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "La atributo \"%1$s\" en etikedo de bloko %2$s estas forĵetita, ĉar la bloko ne deklaras kampon kun tiu identigilo. Deklaru la kampon aŭ skribu ĝin kiel data-, aria- aŭ html-atributon por meti ĝin sur la radikan elementon."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Ĉi tiu konserva ŝlosilo ne estas deklarita de la bloko aŭ ĝiaj etendaĵoj."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Ĉi tiu ŝlosilo ĉe la plej alta nivelo ne estas atributo de la bloko, do ĝi estas ignorata."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Ĉi tiu ŝlosilo estas legata nur ene de la blockstudio-objekto, kiu mankas."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Ĉi tiu valoro ne estas inter la opcioj de la kampo."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Ĉi tiu valoro havas nesubtenatan formon por la kampo."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Ĉi tiu ripetilo havas malpli da vicoj ol la minimumo."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Ĉi tiu ripetilo havas pli da vicoj ol la maksimumo."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Ĉi tiu konserva ŝlosilo havas konfliktantajn kampodifinojn."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "La valoro de la nestita kampo superregas ĉi tiun supranivelan valoron."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Ligadoj de etendaĵoj legas ĉi tiun valoron nur el blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Valoroj de Blockstudio-kampoj devas esti konservitaj en objekto."

