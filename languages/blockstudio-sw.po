#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Sifa ya \"%1$s\" kwenye lebo ya bloku ya %2$s imeondolewa kwa sababu bloku hii haitangazi sehemu yenye kitambulisho hicho. Tangaza sehemu hiyo, au iandike kama sifa ya data-, aria- au html- ili kuiweka kwenye kipengele cha msingi."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Ufunguo huu wa hifadhi haujatangazwa na bloku au viendelezi vyake."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Ufunguo huu wa kiwango cha juu si sifa ya kizuizi, kwa hivyo unapuuziwa."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Ufunguo huu husomwa tu ndani ya kitu cha blockstudio, ambacho hakipo."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Thamani hii haipo kwenye chaguo za sehemu."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Muundo wa thamani hii hautumiki kwa sehemu hii."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Kipanga-rudia hiki kina safu chache kuliko kiwango chake cha chini."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Kipanga-rudia hiki kina safu nyingi kuliko kiwango chake cha juu."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Ufafanuzi wa sehemu za ufunguo huu wa hifadhi unakinzana."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Thamani ya sehemu iliyopachikwa inachukua nafasi ya thamani hii ya kiwango cha juu."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Vifungamanishi vya viendelezi husoma thamani hii kutoka blockstudio.attributes pekee."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Thamani za sehemu za Blockstudio lazima zihifadhiwe katika kitu."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio inatayarisha akiba yake ya bloku. Tafadhali jaribu tena baada ya muda mfupi."

