#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Gikuha ang attribute nga \"%1$s\" sa block tag nga %2$s kay walay field nga adunay maong ID nga gideklara ang block. Ideklara ang field, o isulat kini isip data-, aria- o html- nga attribute aron ibutang kini sa root element."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Wala gideklara sa block o sa mga extension niini kining storage key."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Kining yawe sa pinakataas nga lebel dili attribute sa block, busa wala kini tagda."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Kining yawe basahon lamang sulod sa blockstudio object, nga wala."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Wala kini nga value sa mga kapilian sa field."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Dili suportado alang sa field kining porma sa value."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Mas ubos sa minimum ang gidaghanon sa mga row niining repeater."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Labaw sa maximum ang gidaghanon sa mga row niining repeater."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Nagkasumpaki ang mga kahulugan sa field alang niining storage key."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Gipulihan sa value sa nested field kining value sa taas nga lebel."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Gibasa sa mga extension binding kining value gikan lamang sa blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Kinahanglang tipigan ang mga value sa field sa Blockstudio isip object."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Giandam sa Blockstudio ang cache sa block niini. Sulayi pag-usab sa dili madugay."

#: includes/classes/canvas.php
msgid "Canvas is disabled."
msgstr "Gi-disable ang canvas."

