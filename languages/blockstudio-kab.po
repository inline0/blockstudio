#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Azar \"%1$s\" deg tag n block %2$s yettwakkes acku block ur yesɛi ara field s yisem-nni. Snulfu-d field, neɣ aru-t s wudem n data-, aria- neɣ html- attribute akken ad yettwasbadu ɣef root element."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Tasarut-agi n usekles ur tettwabder ara sɣur block neɣ iseɣzaf-is."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Tasarut-agi deg uswir amezwaru mačči d amutti n uḥric, ɣef waya tettwattu."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Tasarut-agi tettwaɣra kan deg tɣawsa blockstudio, i yellan ulac-itt."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Azal-agi ur yella ara gar tnefrunin n field."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Azal-agi ur yesɛi ara talɣa i yettwasrgen i field."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Repeater-agi yesɛa drus n yikataren ɣef wayen i d-yettwasbadun d adday."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Repeater-agi yesɛa aṭas n yikataren ɣef wayen i d-yettwasbadun d afellay."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Tasarut-agi n usekles tesɛa isefka n field yemgaraden."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Azal n field yeddan deg uswir nniḍen yettbedil azal-agi n uswir amezwaru."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Iseɣzaf ttɣerrin azal-agi kan seg blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Azalen n field n Blockstudio ilaq ad ttussekelsent deg object."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio isewjed tura cache n blocks. Ɛawed ɛreḍ ticki."

