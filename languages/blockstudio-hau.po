msgid "This repeater has more rows than its maximum."
msgstr "Wannan mai maimaitawa yana da layuka fiye da iyakar adadi."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Akwai saɓani tsakanin ma’anonin filayen da aka danganta da wannan maɓallin ajiya."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Ƙimar filin da ke ciki tana maye gurbin wannan ƙima ta sama."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Haɗin kari yana karanta wannan ƙima ne kawai daga blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Dole ne a adana ƙimar filayen Blockstudio a cikin abu."

