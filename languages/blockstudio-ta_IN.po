#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "%2$s பிளாக் குறிச்சொல்லில் உள்ள \"%1$s\" பண்புக்கூறு நீக்கப்பட்டது; அந்த ID கொண்ட புலம் பிளாக் அறிவிப்பில் இல்லை. அந்தப் புலத்தை அறிவிக்கவும் அல்லது மூல உறுப்பில் சேர்க்க அதை data-, aria- அல்லது html- பண்புக்கூறாக எழுதவும்."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "இந்த சேமிப்பக விசை பிளாக் அல்லது அதன் நீட்டிப்புகளால் அறிவிக்கப்படவில்லை."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "இந்த மேல்நிலை விசை தொகுதியின் பண்புக்கூறு அல்ல; எனவே புறக்கணிக்கப்படுகிறது."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "இந்த விசை blockstudio பொருளுக்குள் மட்டுமே படிக்கப்படுகிறது; அந்தப் பொருள் இல்லை."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "இந்த மதிப்பு புல விருப்பங்களில் இல்லை."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "இந்த மதிப்பின் வடிவம் இந்தப் புலத்துக்கு ஆதரிக்கப்படவில்லை."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "இந்த மீளுருவாக்கியில் குறைந்தபட்சத்தைவிடக் குறைவான வரிசைகள் உள்ளன."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "இந்த மீளுருவாக்கியில் அதிகபட்சத்தைவிட அதிகமான வரிசைகள் உள்ளன."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "இந்தச் சேமிப்பக விசைக்கு முரண்படும் புல வரையறைகள் உள்ளன."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "உட்பொதிந்த புலத்தின் மதிப்பு இந்த மேல்நிலை மதிப்பை மேலெழுதுகிறது."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "நீட்டிப்பு பிணைப்புகள் இந்த மதிப்பை blockstudio.attributes இலிருந்து மட்டுமே படிக்கும்."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Blockstudio புல மதிப்புகள் ஒரு பொருளில் சேமிக்கப்பட வேண்டும்."

