msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Kua tangohia te huanga “%1$s” o te tūtohu paraka %2$s nā te mea kāore he āpure i taua ID i te paraka. Whakaūngia te āpure, tuhia rānei hei huanga data-, aria- rānei html- kia whakatakotoria ki te huānga pūtake."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Kāore tēnei kī rokiroki i te whakapuakina e te paraka, e ōna toronga rānei."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Ehara tēnei kī taumata-runga i te huanga o te paraka, nō reira ka waiho kia kaua e arohia."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Ka pānuihia tēnei kī i roto anake i te ahanoa blockstudio, engari kei te ngaro taua ahanoa."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Kāore tēnei uara i roto i ngā kōwhiringa āpure."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Kāore tēnei āhua uara e tautokona ana mō te āpure."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "He iti iho ngā rārangi o tēnei tāruarua i te itinga."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "He nui ake ngā rārangi o tēnei tāruarua i te mōrahi."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "He taupatupatu ngā whakamāramatanga āpure mō tēnei kī rokiroki."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Ka whakakapi te uara āpure kōwhiti i tēnei uara taumata-runga."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Ka pānui ngā here toronga i tēnei uara mai i blockstudio.attributes anake."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Me rokiroki ngā uara āpure Blockstudio hei ahanoa."

#: includes/classes/build.php
