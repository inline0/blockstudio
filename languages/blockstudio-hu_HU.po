#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "A(z) „%1$s” attribútum el lett távolítva a %2$s blokkcímkéből, mert a blokk nem deklarál ilyen azonosítójú mezőt. Deklarálja a mezőt, vagy írja data-, aria- vagy html-attribútumként, hogy a gyökérelemre kerüljön."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Ezt a tárolási kulcsot sem a blokk, sem a bővítményei nem deklarálják."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Ez a legfelső szintű kulcs nem a blokk attribútuma, ezért figyelmen kívül marad."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Ezt a kulcsot csak a blockstudio objektumon belül olvassa be a rendszer, amely hiányzik."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Ez az érték nem szerepel a mező választható értékei között."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Ennek az értéknek a formátuma nem támogatott ennél a mezőnél."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Ez az ismétlő kevesebb sort tartalmaz a minimálisnál."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Ez az ismétlő több sort tartalmaz a maximálisnál."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Ehhez a tárolási kulcshoz ütköző meződefiníciók tartoznak."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "A beágyazott mező értéke felülírja ezt a legfelső szintű értéket."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "A bővítménykötések ezt az értéket csak a blockstudio.attributes mezőből olvassák."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "A Blockstudio mezőértékeit objektumként kell tárolni."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "A Blockstudio előkészíti a blokkgyorsítótárat. Kérjük, próbálja újra rövidesen."

