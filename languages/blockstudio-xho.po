#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Uphawu \"%1$s\" kwithegi yebhloko ye-%2$s alufakwa kuba ibhloko ayichazanga ntsimi inale ID. Chaza loo ntsimi, okanye ulubhale njengophawu lwe-data-, aria- okanye html- ukuze lubekwe kwinto engundoqo."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Eli qhosha lokugcina alichazwanga yibhloko okanye zizandiso zayo."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Esi sitshixo sikwinqanaba eliphezulu asilo phawu lwebhloko, ngoko asihoywa."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Esi sitshixo sifundwa kuphela ngaphakathi kwento ethi blockstudio, engekhoyo."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Eli xabiso alikho phakathi kokhetho lwentsimi."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Ubume beli xabiso abuxhaswanga kule ntsimi."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Le repeater inemiqolo embalwa kunobuncinane obumiselweyo."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Le repeater inemiqolo emininzi kunobuninzi obumiselweyo."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Le key yokugcina ineenkcazelo zentsimi ezingqubanayo."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Ixabiso lentsimi engaphakathi lithatha indawo yeli xabiso likumgangatho ophezulu."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Izibophelelo zezandiso zifunda eli xabiso kwi-blockstudio.attributes kuphela."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Amaxabiso entsimi yeBlockstudio kufuneka agcinwe kwinto."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "I-Blockstudio ilungiselela i-cache yeebhloko zayo. Nceda uzame kwakhona kungekudala."

