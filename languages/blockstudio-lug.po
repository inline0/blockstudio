#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Ekintu \"%1$s\" ku kika kya block %2$s kiggyibwawo kubanga block eno terina field erina ID eyo. Langa field eyo, oba kiwandiike nga ekintu kya data-, aria- oba html- okukiteeka ku element y’ensibuko."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Ekisumuluzo kino eky’okutereka tekiwandiikiddwa mu block oba ebigigaziyako."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Ekisumuluzo kino ekiri ku mutendera ogw’oku ntikko si kintu kya buloko, n’olwekyo tekikozesebwa."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Ekisumuluzo kino kisomebwa mu kintu kya blockstudio kyokka, ekibulako."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Omuwendo guno teguli mu by’oyinza okulonda ku field eno."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Enteekateeka y’omuwendo guno tewagirwa ku field eno."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Repeater eno erina ennyiriri ntono okusinga ezirina okubaawo."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Repeater eno erina ennyiriri nnyingi okusinga ezisukka ezikkirizibwa."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Ekisumuluzo kino eky’okutereka kirina ebitegeeza field ebikontana."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Omuwendo gwa field eyingiziddwamu gukyusa omuwendo guno oguli ku mutendera ogw’awaggulu."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Extension bindings zisoma omuwendo guno okuva mu blockstudio.attributes zokka."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Emiwendo gya field za Blockstudio girina okuterekebwa mu object."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio eteekateeka cache ya block zaayo. Ddamu okugezaako mu kaseera katono."

#: includes/classes/canvas.php
msgid "Canvas is disabled."
msgstr "Canvas eggaddwa."

