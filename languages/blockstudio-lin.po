#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Attribut \"%1$s\" na elemá ya block %2$s elongolami mpo ete block etángisi champ moko te na ID yango. Tángisa champ yango, to komá yango lokola attribut data-, aria- to html- mpo etyama na elemá ya libándá."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Klé ya ebombeli oyo etángisami te na block to na bilakiseli na yango."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Fungola oyo ezali na nivo ya likoló ezali attribut ya block te, yango wana etalelami te."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Fungola oyo etángamaka kaka na kati ya eloko ya blockstudio, oyo ezali te."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Motuya oyo ezali na kati ya ba options ya champ te."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Lolenge ya motuya oyo endimami te mpo na champ oyo."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Repeater oyo ezali na milɔngɔ moke koleka oyo esengeli."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Repeater oyo ezali na milɔngɔ mingi koleka oyo epesami ndelo."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Ba définition ya champ oyo ezali na matata mpo na klé ya ebombeli oyo."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Motuya ya champ oyo ezali kati na yango eleki motuya oyo ya likoló."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Ba bindings ya extension etángaka motuya oyo kaka na blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Motuya ya champ ya Blockstudio esengeli ebombama lokola objet."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio ezali kobongisa cache ya block na yango. Meká lisusu mwa moke."

#: includes/classes/canvas.php
msgid "Canvas is disabled."
msgstr "Canvas ekangami."

#: includes/classes/database.php
