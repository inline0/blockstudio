#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Eigindinu „%1$s“ á merkimiða %2$s-blokkar er sleppt því blokkin skilgreinir engan reit með því auðkenni. Skilgreindu reitinn eða skrifaðu eigindið sem data-, aria- eða html-eigindi til að setja það á rótarþáttinn."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Þessi geymslulykill er ekki skilgreindur af blokkinni eða viðbótum hennar."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Þessi lykill á efsta stigi er ekki eigindi blokkarinnar og er því hunsaður."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Þessi lykill er aðeins lesinn inni í hlutnum blockstudio, sem vantar."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Þetta gildi er ekki meðal valkosta reitsins."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Þetta gildi hefur snið sem reiturinn styður ekki."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Þessi endurtekari hefur færri raðir en lágmarkið."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Þessi endurtekari hefur fleiri raðir en hámarkið."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Þessi geymslulykill hefur ósamrýmanlegar skilgreiningar reita."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Gildi hreiðraða reitsins yfirskrifar þetta efsta stigs gildi."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Bindingar viðbóta lesa þetta gildi aðeins úr blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Gildi reita í Blockstudio verður að geyma í hlut."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio undirbýr skyndiminni blokkanna. Reyndu aftur eftir stutta stund."

