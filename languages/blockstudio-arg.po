msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "L'atributo «%1$s» d'una etiqueta de bloc %2$s se descarta porque o bloc no declara garra campo con ixe identificador. Declara o campo, u escríbe-lo como atributo data-, aria- u html- pa incluyir-lo en l'elemento radiz."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Esta clau d'almacenamiento no ye declarada por o bloc ni as suyas extensions."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Ista clau de primer nivel no ye un atributo d'o bloque, por o que s'ignora."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Ista clau nomás se lée dentro de l'obchecto blockstudio, que falta."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Este valor no ye entre as opcions d'o campo."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Este valor tien una estructura no compatible con o campo."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Este repetidor tiene menos ringleras que o mínimo."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Este repetidor tiene más ringleras que o máximo."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Esta clau d'almacenamiento tiene definicions de campo en conflicto."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "O valor d'o campo anidau sobrescribe este valor de primer libel."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "As vinculacions d'extensions leen este valor nomás de blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Os valores d'os campos de Blockstudio s'han d'almacenar en un obchecto."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio ye preparando a suya caché de bloques. Torna a prebar-ne luego."

