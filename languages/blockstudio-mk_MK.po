#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Атрибутот „%1$s“ на ознаката за блокот %2$s е отфрлен бидејќи блокот не декларира поле со тој ID. Декларирајте го полето или запишете го како атрибут data-, aria- или html- за да го поставите на коренскиот елемент."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Овој клуч за складирање не е деклариран од блокот или неговите проширувања."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Овој клуч на највисоко ниво не е атрибут на блокот, па се игнорира."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Овој клуч се чита само во објектот blockstudio, кој недостасува."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Оваа вредност не е меѓу опциите на полето."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Оваа вредност има неподдржана структура за полето."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Овој повторувач има помалку редови од минимумот."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Овој повторувач има повеќе редови од максимумот."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Овој клуч за складирање има спротивставени дефиниции на полињата."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Вредноста на вгнезденото поле ја заменува оваа вредност на највисоко ниво."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Врските на проширувањата ја читаат оваа вредност само од blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Вредностите на полињата на Blockstudio мора да се складираат во објект."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio го подготвува кешот на блоковите. Обидете се повторно за кратко."

