#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "%2$s-lohkon tunnisteen \"%1$s\" määritettä ei oteta käyttöön, koska lohko ei määritä kyseistä tunnistetta vastaavaa kenttää. Määritä kenttä tai kirjoita määrite data-, aria- tai html-määritteenä, jotta se lisätään juurielementtiin."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Lohko tai sen laajennukset eivät määritä tätä tallennusavainta."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Tämä ylimmän tason avain ei ole lohkon ominaisuus, joten se ohitetaan."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Tätä avainta luetaan vain blockstudio-objektin sisältä, mutta objekti puuttuu."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Tämä arvo ei kuulu kentän vaihtoehtoihin."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Tämän kentän arvolla on virheellinen muoto."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Toistimessa on vähemmän rivejä kuin vähimmäismäärä."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Toistimessa on enemmän rivejä kuin enimmäismäärä."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Tälle tallennusavaimelle on määritetty ristiriitaisia kenttiä."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Sisäkkäisen kentän arvo ohittaa tämän ylimmän tason arvon."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Laajennusten sidokset lukevat tämän arvon vain blockstudio.attributes-kohdasta."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Blockstudio-kenttien arvot on tallennettava objektina."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio valmistelee lohkovälimuistiaan. Yritä hetken kuluttua uudelleen."

#: includes/classes/canvas.php
msgid "Canvas is disabled."
msgstr "Canvas on poistettu käytöstä."

