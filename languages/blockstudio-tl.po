#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Inalis ang attribute na \"%1$s\" sa tag ng block na %2$s dahil walang field na may ganitong ID ang idineklara ng block. Ideklara ang field o isulat ito bilang data-, aria- o html- attribute upang mailagay ito sa root element."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Hindi idineklara ng block o ng mga extension nito ang storage key na ito."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Ang top-level na key na ito ay hindi attribute ng block, kaya hindi ito pinapansin."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Binabasa lang ang key na ito sa loob ng blockstudio object, na nawawala."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Wala ang value na ito sa mga opsyon ng field."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Hindi suportado ang anyo ng value na ito para sa field."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Mas kaunti sa minimum ang mga row ng repeater na ito."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Mas marami sa maximum ang mga row ng repeater na ito."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "May magkakasalungat na depinisyon ng field para sa storage key na ito."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Pinapalitan ng value ng nested field ang value na ito sa top level."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Mula lang sa blockstudio.attributes binabasa ng mga binding ng extension ang value na ito."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Dapat naka-store bilang object ang mga value ng field ng Blockstudio."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Inihahanda ng Blockstudio ang block cache nito. Pakisubukang muli pagkalipas ng ilang sandali."

#: includes/classes/canvas.php
