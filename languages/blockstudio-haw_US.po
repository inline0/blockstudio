#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Hoʻokuʻu ʻia ke ʻano \"%1$s\" ma kahi hōʻailona poloka %2$s no ka mea, ʻaʻohe kahua i kūkala ʻia e ka poloka me kēlā ID. E kūkala i ke kahua, a i ʻole e kākau iā ia ma ke ʻano he ʻano data-, aria- a i ʻole html- e kau ai ma ka ʻelemu kumu."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "ʻAʻole i kūkala ʻia kēia kī waihona e ka poloka a i ʻole kona mau hoʻonui."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "ʻAʻole kēia kī pae luna he ʻano o ka poloka, no laila nānā ʻole ʻia."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Heluhelu ʻia kēia kī ma loko wale nō o ka mea blockstudio, akā ua nalowale ia."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "ʻAʻole kēia waiwai i waena o nā koho kahua."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "He ʻano kākoʻo ʻole ko kēia waiwai no ke kahua."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "He mau lālani emi aʻe ko kēia mea hana hou ma mua o ka palena iki."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "He mau lālani hou aʻe ko kēia mea hana hou ma mua o ka palena kiʻekiʻe."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "He mau wehewehena kahua kūʻē ko kēia kī waihona."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Hoʻopau ka waiwai kahua i loko i kēia waiwai pae kiʻekiʻe."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Heluhelu nā hoʻopaʻa hoʻonui i kēia waiwai mai blockstudio.attributes wale nō."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Pono e mālama ʻia nā waiwai kahua Blockstudio ma loko o kekahi mea."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Ke hoʻomākaukau nei ʻo Blockstudio i kona ahu hoʻokoe poloka. E hoʻāʻo hou koke."

