msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "L’atribut « %1$s » sus una balisa de bloc %2$s es suprimit perque lo bloc declara pas cap camp amb aquel identificant. Declaratz lo camp o escrivètz-lo coma atribut data-, aria- o html- per l’apondre a l’element raiç."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Aquesta clau d’emmagazinatge es pas declarada pel bloc o sas extensions."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Aquesta clau de nivèl superior es pas un atribut del blòc, doncas es ignorada."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Aquesta clau es legida solament a l’interior de l’objècte blockstudio, que manca."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Aquesta valor figura pas entre las opcions del camp."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Aquesta valor a una forma pas presa en carga pel camp."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Aquest repetidor a mens de linhas que lo minimum."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Aquest repetidor a mai de linhas que lo maximum."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Aquesta clau d’emmagazinatge a de definicions de camp en conflicte."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "La valor del camp imbricat remplaça aquesta valor de primièr nivèl."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Las ligasons d’extension legisson aquesta valor unicament dempuèi blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Las valors dels camps Blockstudio devon èsser emmagazinadas dins un objècte."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio prepara son cache de blocs. Tornatz ensajar lèu."

