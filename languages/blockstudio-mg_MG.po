msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Tsy tafiditra ny toetra \"%1$s\" amin'ny marika sakana %2$s satria tsy misy saha manana io ID io voafaritra ao amin'ilay sakana. Farito ilay saha, na soraty ho toetra data-, aria- na html- mba hampidirana azy ao amin'ny singa fototra."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Tsy voafaritra ao amin'ilay sakana na ny fanitarana azy ity lakilen'ny fitahirizana ity."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Tsy toetran'ny block ity fanalahidy ambaratonga ambony ity, ka tsy raharahina."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Ao anatin'ny zavatra blockstudio ihany no vakina ity fanalahidy ity, nefa tsy hita ilay izy."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Tsy anisan'ny safidin'ity saha ity io sanda io."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Tsy mifanaraka amin'ny endrika tohanan'ity saha ity io sanda io."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Latsaka noho ny fetra farany ambany ny isan'ny andalana ao amin'ity famerimberenana ity."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Mihoatra noho ny fetra farany ambony ny isan'ny andalana ao amin'ity famerimberenana ity."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Misy famaritana saha mifanipaka amin'ity lakilen'ny fitahirizana ity."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Manolo ity sanda ambony ity ny sandan'ny saha anatiny."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Ny fatoran'ny fanitarana dia mamaky ity sanda ity avy amin'ny blockstudio.attributes ihany."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Tsy maintsy tehirizina ao anaty object ny sandan'ny saha Blockstudio."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Manomana ny cache-n'ny sakany ny Blockstudio. Andramo indray afaka kelikely."

