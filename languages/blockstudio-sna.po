#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Chimiro che“%1$s” patagi yebhuroko re%2$s chinobviswa nokuti bhuroko harina munda une ID iyoyo. Gadzira munda wacho, kana kuti chinyore sehunhu hwe data-, aria- kana html- kuti chiiswe pachinhu chikuru."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Kiyi iyi yekuchengetera haina kutsanangurwa nebhuroko kana nezvawedzerwa kwariri."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Kiyi iri padanho repamusoro haisi hunhu hwebhuroko, saka haishandiswi."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Kiyi iyi inoverengwa chete mukati mechinhu cheblockstudio, chisipo."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Ukoshi uhwu hahusi pakati pezvasarudzo zvemunda."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Chimiro cheukoshi uhwu hachitsigirwi nemunda."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Repeater iyi ine mitsara iri pasi pehuwandu hushoma."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Repeater iyi ine mitsara inopfuura huwandu hwepamusoro."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Kiyi iyi yekuchengetera ine tsananguro dzeminda dzinopesana."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Ukoshi hwemunda wakaiswa mukati hunotsiva ukoshi uhwu hwepamusoro."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Zvisungo zvekuwedzera zvinotora ukoshi uhwu kubva mu blockstudio.attributes chete."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Ukoshi hweminda yeBlockstudio hunofanira kuchengetwa sechinhu."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio iri kugadzirira cache yemabhuroko ayo. Edza zvakare munguva pfupi."

