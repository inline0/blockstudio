msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "L’atributo «%1$s» in sci tag do blocco %2$s o l’é scartou perché o blocco o no declara nisciun campo con quello ID. Declara o campo, ò scrivilo comme un atributo data-, aria- ò html- pe mettilo in sci elemento radixe."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Sta ciave de memorizassion a no l’é declarâ da-o blocco ò da-e seu estension."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Sta ciave de livello superióu a no l'é n'atributo do blocco, alùa a ven ignorâ."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Sta ciave a l'é léida solo drento a l'oggetto blockstudio, ch'o manca."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Sto valore o no l’é tra e opcion do campo."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Sto valore o l’à unna forma no supportâ da-o campo."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Sto repeater o l’à meno righe do minimo."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Sto repeater o l’à ciù righe do massimo."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Sta ciave de memorizassion a l’à definission de campo in conflitto."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "O valore do campo annidou o sostitoisce sto valore de livello superio."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "I collegamenti de l’estension a lezzen sto valore solo da blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "I valori di campi Blockstudio gh’an da ese memorizæ in un oggetto."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio o sta preparandone a cache di blocchi. Pe piaxei, repova tra poco."

