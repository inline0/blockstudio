msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Cuirtear an tréith \"%1$s\" ar chlib bhloc %2$s ar leataobh toisc nach ndearbhaíonn an bloc réimse leis an aitheantas sin. Dearbhaigh an réimse, nó scríobh mar thréith data-, aria- nó html- í chun í a chur ar an mbunghné."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Níl an eochair stórála seo dearbhaithe ag an mbloc ná ag a chuid síntí."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Ní tréith den bhloc í an eochair ardleibhéil seo, mar sin déantar neamhaird di."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Ní léitear an eochair seo ach taobh istigh den réad blockstudio, atá ar iarraidh."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Níl an luach seo ar liosta roghanna an réimse."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Tá cruth nach dtacaítear leis ag an luach seo don réimse."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Tá níos lú sraitheanna sa athsheoltóir seo ná mar atá riachtanach."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Tá níos mó sraitheanna sa athsheoltóir seo ná an t-uasmhéid."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Tá sainmhínithe réimse contrártha ag an eochair stórála seo."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Sáraíonn luach an réimse neadaithe an luach barrleibhéil seo."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Ní léann ceangail síntí an luach seo ach ó blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Ní mór luachanna réimse Blockstudio a stóráil in oibiacht."

