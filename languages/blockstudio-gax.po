msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Mallattoo \"%1$s\" jedhu mallattoo block %2$s irratti, block sun id sanaan dirree waan hin ibsineef haqameera. Dirree sana ibsi, yookaan elementii hundee irratti galchuuf akka amalata data-, aria- yookaan html-tti barreessi."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Furtuun kuusaa kun blockiin yookaan dheeressitoota isaatiin hin ibsamne."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Furtuun sadarkaa olaanaa kun amala bilookii miti; kanaaf hin ilaalamu."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Furtuun kun wanta blockstudio keessa jiru keessatti qofa dubbifama; wanti sun hin jiru."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Gatiin kun filannoowwan dirree keessaa miti."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Bifti gatii kun dirree kanaaf hin deeggaramu."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Repeater kun tarreewwan daangaa isaa gadi qaba."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Repeater kun tarreewwan daangaa isaa ol qaba."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Furtuun kuusaa kun hiika dirree walfaallessu qaba."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Gatiin dirree keessaa gatii sadarkaa ol-aanaa kana bakka bu'a."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Hidhamtoonni dheeressituu gatii kana blockstudio.attributes irraa qofa dubbisu."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Gatichi dirree Blockstudio wanta keessatti kuufamuu qaba."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio kuusaa block isaa qopheessaa jira. Mee yeroo gabaabaa booda irra deebi'ii yaali."

