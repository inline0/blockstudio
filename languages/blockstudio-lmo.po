#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "L’atribut \"%1$s\" de la targhetta del blocch %2$s el vegn scartaa perché ‘l blocch nol declara nissun camp cun chel ID. Declara ‘l camp, o scrivìl come atribut data-, aria- o html- per mettìl sü l’element radìs."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Questa ciav de memorizzazion la minga dichiarada dal blocch o da i sò ampliament."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Sta ciav a livel principal la fa minga part di atribut del bloc, e la vegn ignorada."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Sta ciav la vegn leta doma dent l’oget blockstudio, che al manca."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Questa valur la minga tra i opzion del camp."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Questa valur la gh’ha ‘na forma minga suportada per ‘l camp."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Sto repetidor gh’ha meno righe del minim."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Sto repetidor gh’ha piö righe del massim."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Questa ciav de memorizzazion la gh’ha definizion de camp in conflitt."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "La valur del camp annidada la sovrascrìv questa valur de livel superiur."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "I collegament di ampliament leggèn questa valur domà da blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "I valor di camp de Blockstudio hinn de memorizzà in un ogget."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio el sta preparando la cache di blocch. Per piasé, torna a provà tra pocch."

#: includes/classes/canvas.php
