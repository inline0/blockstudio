#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Ar goll eo an elfenn \"%1$s\" war ur valizenn bloc’h %2$s, rak n’eus bet termenet maezienn ebet gant an elfenn-se. Termenit ar maezienn, pe skrivit anezhañ evel un elfenn data-, aria- pe html- evit he lakaat war an elfenn wrizienn."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "N’eo ket termenet an alc’hwez stokañ-mañ gant ar bloc’h pe gant e astennadoù."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "N'eo ket an alc'hwez-mañ ur perzh eus ar bloc'h e live uhelañ, neuze e vez lezet a-gostez."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Lennet e vez an alc'hwez-mañ hepken e-barzh an ergorenn blockstudio, hag a vank."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "N’emañ ket ar werzh-mañ e-touez dibarzhioù ar maezienn."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "N’eo ket stumm ar werzh-mañ skoret evit ar maezienn."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "N’eus ket a-walc’h a renkoù er repeater-mañ evit bezañ dindan ar bihanañ niver aotreet."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Re a renkoù zo er repeater-mañ, hervez ar brasañ niver aotreet."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Ur c’henniñ zo etre termenoù ar maeziennoù evit an alc’hwez stokañ-mañ."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Erlec’hiañ a ra talvoud ar maezienn enklozet an talvoud-mañ eus al live uhel."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Liammoù an astennadoù a lenn an talvoud-mañ eus blockstudio.attributes hepken."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Ret eo stokañ talvoudoù maeziennoù Blockstudio en un ergorenn."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "O prientiñ emañ Blockstudio heñvellec’h ar bloc’hoù. Klaskit en-dro a-benn nebeud."

