#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Το χαρακτηριστικό \"%1$s\" σε ετικέτα μπλοκ %2$s παραλείπεται, επειδή το μπλοκ δεν ορίζει πεδίο με αυτό το αναγνωριστικό. Ορίστε το πεδίο ή γράψτε το ως χαρακτηριστικό data-, aria- ή html- για να προστεθεί στο ριζικό στοιχείο."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Αυτό το κλειδί αποθήκευσης δεν έχει δηλωθεί από το μπλοκ ή τις επεκτάσεις του."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Αυτό το κλειδί στο ανώτατο επίπεδο δεν είναι χαρακτηριστικό του μπλοκ και αγνοείται."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Αυτό το κλειδί διαβάζεται μόνο μέσα στο αντικείμενο blockstudio, το οποίο λείπει."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Αυτή η τιμή δεν περιλαμβάνεται στις επιλογές του πεδίου."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Αυτή η τιμή έχει μη υποστηριζόμενη μορφή για το πεδίο."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Αυτό το επαναλήπτη έχει λιγότερες γραμμές από το ελάχιστο."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Αυτό το επαναλήπτη έχει περισσότερες γραμμές από το μέγιστο."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Αυτό το κλειδί αποθήκευσης έχει αντικρουόμενους ορισμούς πεδίων."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Η τιμή του ένθετου πεδίου αντικαθιστά αυτήν την τιμή ανώτατου επιπέδου."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Οι συνδέσεις επεκτάσεων διαβάζουν αυτήν την τιμή μόνο από το blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Οι τιμές πεδίων του Blockstudio πρέπει να αποθηκεύονται σε ένα αντικείμενο."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Το Blockstudio προετοιμάζει την προσωρινή μνήμη των μπλοκ. Δοκιμάστε ξανά σε λίγο."

