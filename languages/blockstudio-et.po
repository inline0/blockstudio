#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "%2$s plokisildi atribuuti „%1$s” ei lisata, sest plokk ei deklareeri selle ID-ga välja. Deklareeri väli või kirjuta atribuut kujul data-, aria- või html-, et lisada see juurelemendile."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "See salvestusvõti pole ploki ega selle laienduste poolt deklareeritud."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "See tipptaseme võti ei ole ploki atribuut, seega seda eiratakse."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Seda võtit loetakse ainult puuduva blockstudio-objekti sees."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "See väärtus ei kuulu välja valikute hulka."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Selle väärtuse kuju ei sobi väljale."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Selles kordajas on vähem ridu kui miinimum lubab."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Selles kordajas on rohkem ridu kui maksimum lubab."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Selle salvestusvõtme välja määratlused on vastuolus."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Pesastatud välja väärtus kirjutab selle ülataseme väärtuse üle."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Laienduste sidumised loevad seda väärtust ainult atribuudist blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Blockstudio välja väärtused tuleb salvestada objektina."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio valmistab ette plokkide vahemälu. Proovi peagi uuesti."

