#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "O atributo \"%1$s\" na tag de bloco %2$s foi descartado porque o bloco não declara nenhum campo com esse ID. Declare o campo ou escreva-o como atributo data-, aria- ou html- para adicioná-lo ao elemento raiz."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Esta chave de armazenamento não foi declarada pelo bloco nem por suas extensões."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Esta chave de nível superior não é um atributo do bloco e, por isso, é ignorada."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Esta chave só é lida dentro do objeto blockstudio, que está ausente."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Este valor não está entre as opções do campo."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Este valor tem um formato não compatível com o campo."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Este repetidor tem menos linhas do que o mínimo permitido."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Este repetidor tem mais linhas do que o máximo permitido."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Esta chave de armazenamento tem definições de campo conflitantes."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "O valor do campo aninhado substitui este valor de nível superior."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "As vinculações de extensões leem este valor somente de blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Os valores dos campos do Blockstudio devem ser armazenados em um objeto."

