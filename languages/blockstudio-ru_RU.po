#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Атрибут «%1$s» тега блока %2$s удалён, поскольку в блоке не объявлено поле с таким идентификатором. Объявите поле или укажите атрибут с префиксом data-, aria- или html-, чтобы добавить его в корневой элемент."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Этот ключ хранилища не объявлен блоком или его расширениями."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Этот ключ верхнего уровня не является атрибутом блока, поэтому он игнорируется."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Этот ключ считывается только внутри объекта blockstudio, который отсутствует."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Это значение отсутствует среди вариантов поля."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "У этого значения неподдерживаемый формат для данного поля."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "В этом повторителе меньше строк, чем допускает минимум."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "В этом повторителе больше строк, чем допускает максимум."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Для этого ключа хранилища заданы конфликтующие определения полей."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Значение вложенного поля переопределяет это значение верхнего уровня."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Привязки расширений считывают это значение только из blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Значения полей Blockstudio должны храниться в объекте."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio подготавливает кэш блоков. Повторите попытку чуть позже."

