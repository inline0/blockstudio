#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Das Attribut „%1$s“ am %2$s-Block-Tag wird verworfen, weil der Block kein Feld mit dieser ID deklariert. Deklariere das Feld oder schreibe es als data-, aria- oder html-Attribut, damit es am Wurzelelement ausgegeben wird."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Dieser Speicherschlüssel ist weder vom Block noch von seinen Erweiterungen deklariert."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Dieser Schlüssel auf oberster Ebene ist kein Attribut des Blocks und wird daher ignoriert."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Dieser Schlüssel wird nur innerhalb des blockstudio-Objekts gelesen, das fehlt."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Dieser Wert ist nicht in den Feldoptionen enthalten."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Dieser Wert hat ein für das Feld nicht unterstütztes Format."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Dieser Repeater hat weniger Zeilen als das Minimum."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Dieser Repeater hat mehr Zeilen als das Maximum."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Für diesen Speicherschlüssel gibt es widersprüchliche Felddefinitionen."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Der Wert des verschachtelten Felds überschreibt diesen Wert auf oberster Ebene."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Erweiterungsbindungen lesen diesen Wert nur aus blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Blockstudio-Feldwerte müssen in einem Objekt gespeichert werden."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio bereitet den Block-Cache vor. Bitte versuche es in Kürze noch einmal."

