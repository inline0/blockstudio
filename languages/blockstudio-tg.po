#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Атрибути «%1$s» дар теги блоки %2$s ҳазф карда мешавад, зеро блок майдонеро бо чунин ID эълон накардааст. Майдонро эълон кунед ё онро ҳамчун атрибути data-, aria- ё html- нависед, то ба унсури реша илова шавад."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Ин калиди нигоҳдорӣ аз ҷониби блок ё васеъкуниҳои он эълон нашудааст."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Ин калиди сатҳи болоӣ атрибути блок нест, бинобар ин нодида гирифта мешавад."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Ин калид танҳо дар дохили объекти blockstudio хонда мешавад, ки мавҷуд нест."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Ин қимат дар байни имконоти майдон нест."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Сохтори ин қимат барои майдон дастгирӣ намешавад."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Ин такроркунанда аз ҳадди ақали сатрҳо камтар дорад."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Ин такроркунанда аз ҳадди аксари сатрҳо зиёд дорад."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Таърифҳои майдон барои ин калиди нигоҳдорӣ бо ҳам мухолифанд."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Қимати майдони дохилӣ қимати сатҳи болоро иваз мекунад."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Пайвастҳои васеъкунӣ ин қиматро танҳо аз blockstudio.attributes мехонанд."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Қиматҳои майдонҳои Blockstudio бояд ҳамчун объект нигоҳ дошта шаванд."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio кэши блокҳоро омода мекунад. Лутфан каме баъдтар аз нав кӯшиш кунед."

