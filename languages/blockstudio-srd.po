msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "S’attributu \"%1$s\" in un tag de blocu %2$s est eliminadu ca su blocu non declara perunu campu cun cussu id. Declara su campu, o iscrie·lu comente attributu data-, aria- o html- pro inserìlu in s’elementu radiche."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Custa crae de archiviazione non est declarada dae su blocu o dae sas estensiones suas."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Custa crae de livellu superióre no est un'attributu de su blocu, duncas benit ignorada."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Custa crae benit lèghida isceti intro de s'oggetu blockstudio, chi mancat."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Custa balore non est intre sas optziones de su campu."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Custa balore tenet una forma non suportada pro su campu."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Custa lista repetidora tenet prus pagas rinas de su minimu."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Custa lista repetidora tenet prus rinas de su massimu."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Custa crae de archiviazione tenet definiziones de campu in cunflitu."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Sa balore de su campu annidada suprascrit custa balore de livellu superiore."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Sos ligàmenes de estensione lèghene custa balore isceti dae blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Sas balores de sos campos de Blockstudio depent èssere archiviadas in unu ogetu."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio est preparende su cache de sos blocos. Torra a proare a pagu."

