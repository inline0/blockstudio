#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Atributul „%1$s” de pe eticheta blocului %2$s este eliminat deoarece blocul nu declară niciun câmp cu acel ID. Declarați câmpul sau scrieți atributul ca data-, aria- ori html- pentru a-l adăuga la elementul rădăcină."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Această cheie de stocare nu este declarată de bloc sau de extensiile sale."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Această cheie de nivel superior nu este un atribut al blocului, așa că este ignorată."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Această cheie este citită doar în interiorul obiectului blockstudio, care lipsește."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Această valoare nu se află printre opțiunile câmpului."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Această valoare are o structură neacceptată pentru câmp."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Acest repetor are mai puține rânduri decât minimul permis."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Acest repetor are mai multe rânduri decât maximul permis."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Această cheie de stocare are definiții de câmp în conflict."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Valoarea câmpului imbricat suprascrie această valoare de nivel superior."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Asocierile extensiilor citesc această valoare numai din blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Valorile câmpurilor Blockstudio trebuie stocate într-un obiect."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio pregătește memoria cache a blocurilor. Încercați din nou în scurt timp."

