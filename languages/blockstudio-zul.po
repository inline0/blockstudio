msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Isibaluli esithi \"%1$s\" kuthegi yebhulokhi ethi %2$s siyasuswa ngoba ibhulokhi ayinayo inkambu enaleyo ID. Chaza inkambu, noma usibhale njengesibaluli se-data-, aria- noma html- ukuze usifake kusici sempande."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Lo khiye wesitoreji awumenyezelwanga yibhulokhi noma izandiso zayo."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Lo khiye osezingeni eliphezulu awusona isibaluli sebhulokhi, ngakho awunakwa."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Lo khiye ufundwa kuphela ngaphakathi kwento ethi blockstudio, engekho."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Leli nani alikho kokukhethwa kwenkambu."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Leli nani linesimo esingasekelwe sale nkambu."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Lesi siphindaphindi sinemigqa embalwa kunobuncane obudingekayo."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Lesi siphindaphindi sinemigqa eminingi kunobuningi obuvunyelwe."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Lo khiye wesitoreji unezincazelo zenkambu ezingqubuzanayo."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Inani lenkambu engaphakathi lithatha indawo yaleli nani elisezingeni eliphezulu."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Izibopho zezandiso zifunda leli nani kuphela ku-blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Amanani ezinkambu ze-Blockstudio kufanele agcinwe entweni."

#: includes/classes/build.php
