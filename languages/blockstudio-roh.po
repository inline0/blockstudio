#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "L’attribut « %1$s » sin in’etichetta da bloc %2$s vegn omess, perquai che il bloc na declera nagin champ cun quest ID. Declera il champ u scriva l’attribut sco data-, aria- u html- per l’aggiuntar a l’element radisch."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Questa clav da memoria n’è betg declerada dal bloc u da sias extensiuns."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Questa clav al nivel superiur n’è betg in attribut dal bloc e vegn perquai ignorada."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Questa clav vegn legida mo entaifer l’object blockstudio, che manca."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Questa valur n’è betg ina da las opziuns dal champ."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Questa valur ha ina furma betg sustegnida per il champ."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Quest repeter ha damain lingias che il minimum."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Quest repeter ha dapli lingias che il maximum."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Questa clav da memoria ha definiziuns da champs cun conflicts."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "La valur dal champ annidà surpiglia questa valur da la valur al nivel superiur."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Ils bindings d’extensiun legian questa valur mo da blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Las valurs dals champs da Blockstudio ston vegnir arcunadas en in object."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio prepara sia memoria cache dals blocs. Empruvai anc ina giada en curt."

