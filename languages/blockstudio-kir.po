msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "%2$s блог тегиндеги \"%1$s\" атрибуту алынып салынды, анткени блокто мындай ID менен талаа аныкталган эмес. Талааны аныктаңыз же аны түпкү элементке кошуу үчүн data-, aria- же html- атрибуту катары жазыңыз."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Бул сактагыч ачкычы блокто же анын кеңейтмелеринде аныкталган эмес."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Бул жогорку деңгээлдеги ачкыч блоктун атрибуту эмес, ошондуктан эске алынбайт."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Бул ачкыч blockstudio объектисинин ичинде гана окулат, бирок ал жок."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Бул маани талаанын варианттарынын арасында жок."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Бул маани талаа үчүн колдоого алынбаган түзүлүштө."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Бул кайталоочу талаада саптардын саны минимумдан аз."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Бул кайталоочу талаада саптардын саны максимумдан көп."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Бул сактагыч ачкычы үчүн талаалар карама-каршы аныкталган."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Ички талаанын мааниси бул жогорку деңгээлдеги маанини алмаштырат."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Кеңейтме байланыштары бул маанини blockstudio.attributes ичинен гана окуйт."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Blockstudio талааларынын маанилери объектте сакталууга тийиш."

