#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Atrybut „%1$s” w znaczniku bloku %2$s jest pomijany, ponieważ blok nie deklaruje pola o tym identyfikatorze. Zadeklaruj pole lub zapisz atrybut jako data-, aria- albo html-, aby umieścić go w elemencie głównym."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Ten klucz przechowywania nie został zadeklarowany przez blok ani jego rozszerzenia."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Ten klucz najwyższego poziomu nie jest atrybutem bloku, dlatego jest ignorowany."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Ten klucz jest odczytywany tylko wewnątrz obiektu blockstudio, którego brakuje."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Ta wartość nie należy do dostępnych opcji pola."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Ta wartość ma nieobsługiwany format dla tego pola."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Ten powtarzalny element zawiera mniej wierszy, niż wynosi minimum."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Ten powtarzalny element zawiera więcej wierszy, niż wynosi maksimum."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Dla tego klucza przechowywania zdefiniowano sprzeczne pola."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Wartość zagnieżdżonego pola zastępuje tę wartość najwyższego poziomu."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Powiązania rozszerzeń odczytują tę wartość wyłącznie z blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Wartości pól Blockstudio muszą być przechowywane w obiekcie."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio przygotowuje pamięć podręczną bloków. Spróbuj ponownie za chwilę."

