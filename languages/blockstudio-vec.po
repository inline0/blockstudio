#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "L’attributo \"%1$s\" sul tag de blocco %2$s el vien scartà parchè el blocco no ga dichiarà nissun campo co’ chel ID. Dichiara el campo, o scrivilo come attributo data-, aria- o html- par metarlo su l’elemento radize."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Sta ciave de memorizazion no la xe dichiarà dal blocco o da le so estension."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Sta ciave a livèl principal no la xe un atributo del bloco, quindi la vien ignorada."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Sta ciave la vien leza solo rento l’ogeto blockstudio, che manca."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Sto valor no’l xe tra le opzion del campo."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Sta forma de valor no la xe suportada par el campo."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Sto repeater el ga manco righe del minimo."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Sto repeater el ga più righe del massimo."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Sta ciave de memorizazion la ga definizion de campo in conflito."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "El valor del campo nidià el sovrascrive sto valor de livel superior."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "I colegamenti de le estension i legi sto valor solo da blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "I valori dei campi de Blockstudio i ga da esser memorizài in un ogeto."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio el sta preparando la cache dei blocchi. Riprova tra poco."

