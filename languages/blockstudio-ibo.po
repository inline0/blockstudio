#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "A na-ewepụ àgwà \"%1$s\" dị na mkpado blọk %2$s n'ihi na blọk ahụ ekwupụtaghị ubi nwere ID ahụ. Kwuo ubi ahụ, ma ọ bụ dee ya dịka àgwà data-, aria- ma ọ bụ html- ka ọ pụta na mmewere mgbọrọgwụ."

