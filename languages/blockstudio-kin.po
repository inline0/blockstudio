#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "Ikiranga \"%1$s\" kiri kuri tagi ya blok %2$s kiravanywaho kuko iyo blok itatangaza umurima ufite iyo ID. Tangaza uwo murima, cyangwa wandike ikiranga nka data-, aria- cyangwa html- kugira ngo kijye ku kintu-muzi."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Uru rufunguzo rw'ububiko ntirwatangajwe na blok cyangwa ibyongerwaho byayo."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Iyi keyi yo ku rwego rwo hejuru si ikiranga cya block, bityo ntiyitabwaho."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Iyi keyi isomwa gusa imbere muri object ya blockstudio, itariho."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Iyi gaciro ntiri mu mahitamo y'umurima."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Imiterere y'iyi gaciro ntishyigikiwe n'umurima."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Uyu musubiramo ufite imirongo mike kurusha umubare ntarengwa wo hasi."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Uyu musubiramo ufite imirongo irenze umubare ntarengwa wo hejuru."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Uru rufunguzo rw'ububiko rufite ibisobanuro by'imirima bivuguruzanya."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Agaciro k'umurima ushyizwe imbere gasimbura aka gaciro ko ku rwego rwo hejuru."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Ibyongerwaho bifungisha agaciro bisoma aka gaciro muri blockstudio.attributes gusa."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Indangagaciro z'imirima ya Blockstudio zigomba kubikwa mu kintu."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio irimo gutegura ububiko bw'amakuru bw'amablok yayo. Ongera ugerageze nyuma gato."

