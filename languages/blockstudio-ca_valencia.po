#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "L'atribut «%1$s» de l'etiqueta del bloc %2$s s'ignora perquè el bloc no declara cap camp amb eixe identificador. Declara el camp o escriu-lo com a atribut data-, aria- o html- per a afegir-lo a l'element arrel."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Esta clau d'emmagatzematge no està declarada pel bloc ni per les seues extensions."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Aquesta clau de nivell superior no és un atribut del bloc, així que s’ignora."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Aquesta clau només es llig dins de l’objecte blockstudio, que falta."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Este valor no està entre les opcions del camp."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Este valor té un format no compatible amb el camp."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Este repetidor té menys files que el mínim."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Este repetidor té més files que el màxim."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Esta clau d'emmagatzematge té definicions de camp incompatibles."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "El valor del camp imbricat substituïx este valor de nivell superior."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "Les vinculacions de les extensions lliguen este valor només de blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Els valors dels camps de Blockstudio s'han d'emmagatzemar en un objecte."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio està preparant la memòria cau dels blocs. Torna-ho a provar d'ací a poc."

#: includes/classes/canvas.php
msgid "Canvas is disabled."
msgstr "El llenç està desactivat."

