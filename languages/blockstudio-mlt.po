#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "L-attribut \"%1$s\" fuq tikketta ta' blokka %2$s ma jiġix inkluż għax il-blokka ma tiddikjara ebda qasam b'dak l-ID. Iddikjara l-qasam, jew ikteb l-attribut bħala data-, aria- jew html- biex tpoġġih fuq l-element ewlieni."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Din iċ-ċavetta tal-ħażna mhijiex iddikjarata mill-blokka jew mill-estensjonijiet tagħha."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Din iċ-ċavetta fl-ogħla livell mhijiex attribut tal-blokka, għalhekk tiġi injorata."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Din iċ-ċavetta tinqara biss ġewwa l-oġġett blockstudio, li huwa nieqes."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Dan il-valur mhuwiex fost l-għażliet tal-qasam."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Dan il-valur għandu struttura mhux appoġġjata għal dan il-qasam."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Dan ir-repeater għandu inqas ringieli mill-minimu."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Dan ir-repeater għandu aktar ringieli mill-massimu."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Din iċ-ċavetta tal-ħażna għandha definizzjonijiet ta' oqsma konfliġġenti."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Il-valur tal-qasam imbejta jieħu post dan il-valur fil-livell ewlieni."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "L-irbit tal-estensjonijiet jaqra dan il-valur biss minn blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "Il-valuri tal-oqsma ta' Blockstudio jridu jinħażnu f'oġġett."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio qed iħejji l-cache tal-blokki tiegħu. Erġa' pprova dalwaqt."

#: includes/classes/canvas.php
msgid "Canvas is disabled."
msgstr "Il-kanvas huwa diżattivat."

