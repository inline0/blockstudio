#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "L'attributo \"%1$s\" su un tag di blocco %2$s viene ignorato perché il blocco non dichiara alcun campo con quell'ID. Dichiara il campo oppure scrivilo come attributo data-, aria- o html- per inserirlo nell'elemento radice."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Questa chiave di archiviazione non è dichiarata dal blocco né dalle sue estensioni."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Questa chiave di primo livello non è un attributo del blocco, quindi viene ignorata."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Questa chiave viene letta solo all'interno dell'oggetto blockstudio, che manca."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Questo valore non è tra le opzioni del campo."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Questo valore ha una struttura non supportata per il campo."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Questo ripetitore ha meno righe del minimo consentito."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Questo ripetitore ha più righe del massimo consentito."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Questa chiave di archiviazione ha definizioni di campo in conflitto."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "Il valore del campo annidato sovrascrive questo valore di primo livello."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "I binding delle estensioni leggono questo valore solo da blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "I valori dei campi di Blockstudio devono essere archiviati in un oggetto."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio sta preparando la cache dei blocchi. Riprova tra poco."

