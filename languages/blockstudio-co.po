#: blockstudio.php
msgid "Blockstudio"
msgstr "Blockstudio"

#. translators: 1: attribute name, 2: block name.
#: includes/classes/block-tags.php
#, php-format
msgid "The \"%1$s\" attribute on a %2$s block tag is dropped because the block declares no field with that id. Declare the field, or write it as a data-, aria- or html- attribute to put it on the root element."
msgstr "L'attributu «%1$s» nant'à un tag di bloccu %2$s hè scartatu perchè u bloccu ùn dichjara nisun campu cù st'id. Dichjarate u campu, o scrivitelu cum'è attributu data-, aria- o html- per aghjunghjelu à l'elementu radica."

#: includes/classes/block-validator.php
msgid "This storage key is not declared by the block or its extensions."
msgstr "Sta chjave di almacenamiento ùn hè dichjarata da u bloccu nè da e so estensioni."

#: includes/classes/block-validator.php
msgid "This top-level key is not an attribute of the block, so it is ignored."
msgstr "Sta chjave di livellu superiore ùn hè micca un attributu di u bloccu, dunque hè ignorata."

#: includes/classes/block-validator.php
msgid "This key is only read inside the blockstudio object, which is missing."
msgstr "Sta chjave hè letta solu in l'ughjettu blockstudio, chì manca."

#: includes/classes/block-validator.php
msgid "This value is not among the field options."
msgstr "Stu valore ùn face micca parte di l'opzioni di u campu."

#: includes/classes/block-validator.php
msgid "This value has an unsupported shape for the field."
msgstr "Stu valore hà una forma micca supportata per u campu."

#: includes/classes/block-validator.php
msgid "This repeater has fewer rows than its minimum."
msgstr "Stu ripetitore hà menu righe chè u minimu."

#: includes/classes/block-validator.php
msgid "This repeater has more rows than its maximum."
msgstr "Stu ripetitore hà più righe chè u massimu."

#: includes/classes/block-validator.php
msgid "This storage key has conflicting field definitions."
msgstr "Sta chjave di almacenamiento hà definizioni di campu cunflittuali."

#: includes/classes/block-validator.php
msgid "The nested field value overrides this top-level value."
msgstr "U valore di u campu annidatu rimpiazza stu valore di primu livellu."

#: includes/classes/block-validator.php
msgid "Extension bindings read this value only from blockstudio.attributes."
msgstr "I ligami di l'estensione leghjenu stu valore solu da blockstudio.attributes."

#: includes/classes/block-validator.php
msgid "Blockstudio field values must be stored in an object."
msgstr "I valori di i campi di Blockstudio devenu esse almacenati in un oggettu."

#: includes/classes/build.php
msgid "Blockstudio is preparing its block cache. Please retry shortly."
msgstr "Blockstudio prepara a so cache di blocchi. Pruvate torna da quì à pocu."

#: includes/classes/canvas.php
msgid "Canvas is disabled."
msgstr "Canvas hè disattivatu."

