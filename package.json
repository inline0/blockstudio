{
  "name": "blockstudio",
  "version": "7.7.8",
  "description": "The block framework for WordPress",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.12.0"
  },
  "scripts": {
    "build:llm": "node scripts/build-llm.ts",
    "build": "npm run build:runtime && wp-scripts build --config webpack.config.ts --disable-interpret",
    "catalog:blocks": "playwright test tests/e2e/catalog-blocks.ts --config=playwright.wp-env.config.ts",
    "audit:neutrality": "node scripts/audit-product-neutrality.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run audit:tooling && npm run runtime:check && npm run docs:check && npm run schemas:check && npm run audit:neutrality && npm run i18n:check && npm run i18n:coverage && npm run test:client && npm run test:tooling",
    "dev": "npm run build:runtime && wp-scripts start src/blocks/index.tsx --output-path=includes/admin/assets/blocks --config webpack.config.ts --disable-interpret",
    "docs:check": "node scripts/check-docs-content.ts",
    "docs:generate": "node scripts/generate-docs.ts",
    "eval:blocks": "node evals/run.ts block-definition",
    "eval:config": "node evals/run.ts configuration",
    "eval:extensions": "node evals/run.ts extension",
    "eval:hooks": "node evals/run.ts hook",
    "eval:pages": "node evals/run.ts page",
    "eval:patterns": "node evals/run.ts pattern",
    "eval:templates": "node evals/run.ts template",
    "eval": "node evals/run.ts",
    "fix": "npm run lint -- --fix && npm run format",
    "format": "oxfmt --write .",
    "generate:icons": "node scripts/generate-icons.ts",
    "generate:tailwind": "node scripts/generate-tailwind-data.ts",
    "i18n": "node scripts/i18n.ts",
    "i18n:check": "node scripts/i18n.ts --check",
    "i18n:locales": "node scripts/i18n-locales.ts",
    "i18n:translate": "node scripts/translate.ts",
    "i18n:coverage": "node scripts/translate.ts --check",
    "lint": "node scripts/lint.ts",
    "playground:start": "node scripts/playground.ts start",
    "schemas:check": "node scripts/check-schemas.ts",
    "test:e2e:empty": "playwright test --config=playwright.wp-env.empty.config.ts",
    "test:e2e:playground": "node scripts/playground.ts test",
    "test:e2e:ui:regressions": "playwright test --config=tests/ui/playwright.config.ts 'ui/(select[^/]*|card-assets|showcase|controlled-bindings|number-field|toggle|collapsible|toolbar|catalog)\\.spec\\.ts$'",
    "test:client": "node --import tsx --test tests/client/*.test.ts",
    "test:e2e": "playwright test --config=playwright.wp-env.config.ts; npm run wp-env:reset",
    "test:unit": "node scripts/wp-env.ts main unit",
    "types": "node scripts/generate-types.ts",
    "wp-env:empty:start": "node scripts/wp-env.ts empty start",
    "wp-env:empty:stop": "node scripts/wp-env.ts empty stop",
    "wp-env:implementations:start": "npm run wp-env:implementations:plugin:start && npm run wp-env:implementations:mu-plugin:start && npm run wp-env:implementations:composer-theme:start && npm run wp-env:implementations:composer-plugin:start",
    "wp-env:implementations:stop": "npm run wp-env:implementations:plugin:stop; npm run wp-env:implementations:mu-plugin:stop; npm run wp-env:implementations:composer-theme:stop; npm run wp-env:implementations:composer-plugin:stop",
    "wp-env:implementations:plugin:start": "node scripts/wp-env.ts plugin start",
    "wp-env:implementations:plugin:verify": "node scripts/wp-env.ts plugin verify",
    "wp-env:implementations:plugin:stop": "node scripts/wp-env.ts plugin stop",
    "wp-env:implementations:mu-plugin:start": "node scripts/wp-env.ts mu-plugin start",
    "wp-env:implementations:mu-plugin:verify": "node scripts/wp-env.ts mu-plugin verify",
    "wp-env:implementations:mu-plugin:stop": "node scripts/wp-env.ts mu-plugin stop",
    "wp-env:implementations:composer-theme:start": "node scripts/wp-env.ts composer-theme start",
    "wp-env:implementations:composer-theme:verify": "node scripts/wp-env.ts composer-theme verify",
    "wp-env:implementations:composer-theme:stop": "node scripts/wp-env.ts composer-theme stop",
    "wp-env:implementations:composer-plugin:start": "node scripts/wp-env.ts composer-plugin start",
    "wp-env:implementations:composer-plugin:verify": "node scripts/wp-env.ts composer-plugin verify",
    "wp-env:implementations:composer-plugin:stop": "node scripts/wp-env.ts composer-plugin stop",
    "wp-env:reset": "node scripts/wp-env.ts main reset",
    "wp-env:start": "node scripts/wp-env.ts main start",
    "wp-env:stop": "node scripts/wp-env.ts main stop",
    "build:runtime": "node scripts/build-runtime.ts",
    "build:release": "node scripts/build-release.ts",
    "audit:tooling": "node scripts/audit-tooling.ts",
    "format:check": "oxfmt --check .",
    "runtime:check": "node scripts/build-runtime.ts --check",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tooling.json && tsc -p tsconfig.browser.json && npm --prefix packages/registry run typecheck",
    "test:tooling": "node --test scripts/ci/*.test.ts scripts/tests/*.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/lang-css": "^6.2.1",
    "@codemirror/lang-html": "^6.4.8",
    "@codemirror/lang-javascript": "^6.2.1",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-php": "^6.0.1",
    "@emotion/react": "^11.10.5",
    "@floating-ui/dom": "^1.7.3",
    "@hello-pangea/dnd": "^18.0.1",
    "@tiptap/extension-link": "^3.2.0",
    "@tiptap/extension-text-align": "^3.2.0",
    "@tiptap/extension-underline": "^3.2.0",
    "@tiptap/react": "^3.2.0",
    "@tiptap/starter-kit": "^3.2.0",
    "@uiw/codemirror-theme-github": "^4.21.21",
    "@uiw/react-codemirror": "^4.21.21",
    "@wordpress/api-fetch": "^7.22.0",
    "@wordpress/block-editor": "^15.1.0",
    "@wordpress/blocks": "^15.1.0",
    "@wordpress/components": "^32.1.0",
    "@wordpress/compose": "^7.39.0",
    "@wordpress/data": "^10.22.0",
    "@wordpress/dom-ready": "^4.22.0",
    "@wordpress/element": "^6.22.0",
    "@wordpress/hooks": "^4.22.0",
    "@wordpress/i18n": "^6.12.0",
    "@wordpress/icons": "^11.6.0",
    "@wordpress/interactivity": "^6.22.0",
    "@wordpress/plugins": "^7.22.0",
    "html-react-parser": "^5.0.6",
    "htmlparser2": "^10.1.0",
    "lodash-es": "^4.17.21",
    "node-html-parser": "^7.0.1",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^6.0.0",
    "react-router-dom": "^7.13.0",
    "style-to-object": "^1.0.4",
    "usehooks-ts": "^3.1.0"
  },
  "overrides": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.6",
    "@emotion/babel-preset-css-prop": "^11.12.0",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@material-design-icons/svg": "^0.14.2",
    "@playwright/test": "^1.58.1",
    "@primer/octicons": "^19.1.0",
    "@tabler/icons": "^3.31.0",
    "@tannin/plural-forms": "1.1.0",
    "@types/express": "^5.0.6",
    "@types/lodash-es": "^4.17.10",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-html-parser": "^2.0.6",
    "@types/wordpress__block-editor": "^15.0.0",
    "@vscode/codicons": "^0.0.44",
    "@wordpress/babel-preset-default": "^8.22.0",
    "@wordpress/dependency-extraction-webpack-plugin": "^6.22.0",
    "@wordpress/env": "^10.39.0",
    "@wordpress/scripts": "^31.4.0",
    "@wp-playground/cli": "3.1.60",
    "ajv": "^8.17.1",
    "autoprefixer": "^10.4.19",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.10.2",
    "boxicons": "^2.1.4",
    "css.gg": "^2.0.0",
    "cssnano": "^7.0.1",
    "effect": "4.0.6",
    "eslint-plugin-react": "^7.29.2",
    "express": "^5.2.1",
    "feather-icons": "^4.29.0",
    "flat-color-icons": "^1.1.0",
    "grommet-icons": "^4.8.0",
    "heroicons": "^2.0.13",
    "ionicons": "^8.0.0",
    "jsdom": "^26.1.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "php-parser": "3.7.0",
    "prettier": "^3.8.1",
    "quicktype": "^23.0.0",
    "remixicon": "^4.0.1",
    "simple-icons": "^16.7.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.7.0",
    "typescript": "5.9.3"
  }
}
